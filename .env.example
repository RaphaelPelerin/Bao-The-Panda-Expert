# Leave every key empty to run in offline mode (built-in panda knowledge base).

# --- OpenAI-compatible provider (DeepSeek, Qwen, Kimi, GLM, Groq...) ---
# Presets: deepseek (default) | qwen (Alibaba Cloud, mainland China) | qwen-intl (Alibaba Cloud, international)
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Optional overrides, required for providers without a preset (for example Kimi: https://api.moonshot.cn/v1).
LLM_BASE_URL=
LLM_MODEL=

# --- Claude (optional) ---
ANTHROPIC_API_KEY=
# Model used for Claude answers. claude-haiku-5-5 is faster if latency matters more than depth.
PANDA_MODEL=claude-opus-5-5

# auto: OpenAI-compatible provider if LLM_API_KEY is set, then Claude, then offline
# openai | claude | offline: use only that one
PANDA_PROVIDER=auto

# Port for `npm start` (production server).
PORT=8787
