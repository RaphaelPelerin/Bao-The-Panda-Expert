# Leave LLM_API_KEY empty to run in offline mode (built-in panda knowledge base).

# --- Qwen Flash on Alibaba Cloud Model Studio (free quota) ---
# API key from the Model Studio console (DashScope).
LLM_API_KEY=
# Region of the account: qwen-intl (default, created outside mainland China) | qwen (mainland China)
LLM_PROVIDER=qwen-intl
# Questions per day sent to Qwen (about 500-1000 tokens each); after that Bao answers offline
# until midnight. 0 = no limit. Counted in .qwen-usage.json.
QWEN_DAILY_LIMIT=100

# auto: Qwen, then offline when the daily quota runs out | qwen: Qwen only | offline: knowledge base only
PANDA_PROVIDER=auto

# Only for scripts/generate-video.ts (video generation), not for the panda's answers.
OPENROUTER_API_KEY=

# Port for `npm start` (production server).
PORT=8787
