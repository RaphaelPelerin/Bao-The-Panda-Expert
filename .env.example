# Leave every key empty to run in offline mode (built-in panda knowledge base).

# --- LLM: Qwen Flash by default (fast, cheap, free quota for new Alibaba Cloud accounts) ---
# Key from Alibaba Cloud Model Studio (DashScope).
LLM_API_KEY=
# qwen-intl (default, account created outside mainland China) | qwen (mainland China account) | deepseek
LLM_PROVIDER=qwen-intl
# Optional overrides. Required for providers without a preset (for example Kimi: https://api.moonshot.cn/v1).
LLM_BASE_URL=
LLM_MODEL=

# --- Claude (optional) ---
ANTHROPIC_API_KEY=
PANDA_MODEL=claude-opus-5-5

# auto: LLM_API_KEY provider, then Claude, then offline | openai | claude | offline: only that one
PANDA_PROVIDER=auto

# Port for `npm start` (production server).
PORT=8787
