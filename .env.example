# Claude credentials. Leave empty to run in offline mode (built-in panda knowledge base).
ANTHROPIC_API_KEY=

# auto (Claude, falling back to offline on auth/network errors) | claude | offline
PANDA_PROVIDER=auto

# Model used for answers. claude-haiku-5-5 is faster if latency matters more than depth.
PANDA_MODEL=claude-opus-5-5

# Port for `npm start` (production server).
PORT=8787
