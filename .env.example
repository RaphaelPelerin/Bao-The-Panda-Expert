# Required for answers (local `npm run dev` / `npm start`, and Vercel env).
# Model is always qwen-flash-character — not configurable.
LLM_API_KEY=

# DashScope region: qwen-intl (default) | qwen (mainland China)
LLM_PROVIDER=qwen-intl

# Questions allowed per day across the whole site, shown at the bottom right. Empty or 0: no limit.
QWEN_DAILY_LIMIT=

# Shared counter for Vercel (Upstash Redis, free tier). Without it, each serverless
# instance counts on its own and the site shows the number as approximate.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only for scripts/generate-video.ts (video generation), not for answers.
OPENROUTER_API_KEY=

# Port for `npm start`.
PORT=8787
